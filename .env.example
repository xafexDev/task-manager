# ===========================
# Приложение
# ===========================
APP_ENV=development
APP_NAME=Task Manager API
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ===========================
# База данных
# По умолчанию SQLite (без Docker, async driver aiosqlite).
# Для PostgreSQL используйте asyncpg (НЕ psycopg2 — он синхронный, async engine не запустится):
#   DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
# ===========================
DATABASE_URL=sqlite+aiosqlite:///./taskmanager.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/taskmanager

# ===========================
# JWT / Безопасность
# Секрет должен быть заменён в продакшене (используйте `openssl rand -hex 32`)
# ===========================
JWT_SECRET_KEY=change-me-in-production-please-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================
# CORS (через запятую)
# ===========================
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ===========================
# Rate Limiting (через Redis, опционально)
# Если Redis недоступен — rate limiter отключается автоматически
# ===========================
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=100
REDIS_URL=redis://localhost:6379/0

# ===========================
# Загрузка файлов (локально)
# ===========================
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_MIME_TYPES=image/png,image/jpeg,image/gif,application/pdf,text/plain,application/zip

# ===========================
# Фоновые задачи (email) — заглушка, реальный SMTP не настраивается
# ===========================
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.com
